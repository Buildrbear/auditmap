{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.auditmap.org/schemas/national-work-packet-claims.schema.json",
  "title": "AuditMap national work-packet claim ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "updatedAt", "claims"],
  "properties": {
    "$schema": {
      "const": "./schemas/national-work-packet-claims.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packetId",
        "assignee",
        "assignmentUrl",
        "issueUrl",
        "claimedAt",
        "expiresAt",
        "lastUpdatedAt",
        "status"
      ],
      "properties": {
        "packetId": {
          "type": "string",
          "pattern": "^(release-reconciliation|research-completion|local-production-sync)-[a-z]{2}-[a-z0-9-]+-[0-9]{2}$"
        },
        "assignee": {
          "type": "string",
          "minLength": 1
        },
        "assignmentUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "issueUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "claimedAt": {
          "type": "string",
          "format": "date"
        },
        "expiresAt": {
          "type": "string",
          "format": "date"
        },
        "lastUpdatedAt": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": ["claimed", "submitted", "changes-requested", "accepted", "released"]
        },
        "submissionUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "pullRequestUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "acceptedRecordIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/us/"
          }
        },
        "reviewQueue": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issue", "recommendation"],
            "properties": {
              "issue": { "type": "string", "minLength": 1 },
              "recommendation": { "type": "string", "minLength": 1 },
              "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
