# Browser-safe public configuration can remain in config.js.
# These values are server-only and belong in Vercel, never in GitHub.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use "none" until social provider credentials are enabled in Supabase.
SUPABASE_AUTH_PROVIDERS=none
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_ENABLED=false
OPENAI_ENRICHMENT_MODEL=gpt-4.1-mini
OPENAI_MODERATION_MODEL=gpt-4.1-mini
ENRICHMENT_ADMIN_TOKEN=
MODERATION_ADMIN_TOKEN=
CRON_SECRET=
CONTRIBUTION_HASH_SALT=
ABUSE_HASH_SALT=
CRUMB_PILOT_PLACE_IDS=dix-park
CRUMB_MEDIA_BUCKET=community-media-inbox
# Emergency switches. Set any value to false in Vercel to pause that surface immediately.
COMMUNITY_WRITES_ENABLED=true
COMMUNITY_REPORTS_ENABLED=true
MEDIA_UPLOADS_ENABLED=true
PROFILE_PHOTOS_ENABLED=true
# Keep false until profile-photo moderation is connected for non-demo accounts.
PUBLIC_PROFILE_PHOTOS_ENABLED=false
ASK_AI_ENABLED=true
