{"place":{"id":"launch-ny-new-york-city-governors-island","name":"Governors Island","hiddenFeatureIds":[]},"features":[{"id":"07f67674-8a36-4586-9ec8-1da60f76432a","slug":"the-hills-and-slide-hill","name":"The Hills and Slide Hill","feature_type":"destination","description":"The Hills include Outlook, Discovery, Grassy, and Slide Hill. Slide Hill has long slides and climbing routes; the entire South Island zone closes at dusk.","latitude":40.6034005,"longitude":-74.0718306,"source_label":"Trust for Governors Island","source_url":"https://www.govisland.com/plan-your-visit","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"The Hills at Grasmere, Staten Island, Richmond County, New York, United States","coordinateSource":"OpenStreetMap Nominatim","informationSourceLabel":"Trust for Governors Island","informationSourceUrl":"https://www.govisland.com/plan-your-visit","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/new-york-city-super/governors-island/01-governors-island-at-sunset-4915890617-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File%3AGovernors_Island_at_sunset_(4915890617).jpg","imageAuthor":"DearEdward from New York, NY, USA","imageLicense":"CC BY 2.0","imageAlt":"The Hills and Slide Hill at Governors Island"}},{"id":"328d4eb3-6b36-49e1-95ab-29f53dfb1016","slug":"hammock-grove","name":"Hammock Grove","feature_type":"destination","description":"Hammock Grove has suspended hammocks and play lawns in the South Island landscape. Hammocks are first-come and the zone closes at dusk.","latitude":40.6885709,"longitude":-74.0204933,"source_label":"Trust for Governors Island","source_url":"https://www.govisland.com/plan-your-visit","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"Hammock Grove, Liggett Terrace, Manhattan, New York County, New York, United States","coordinateSource":"OpenStreetMap Nominatim","informati