{"place":{"id":"launch-ma-boston-rose-fitzgerald-kennedy-greenway","name":"Rose Fitzgerald Kennedy Greenway","hiddenFeatureIds":[]},"features":[{"id":"e00770f9-9940-4cd0-9099-510584446b89","slug":"greenway-carousel","name":"Greenway Carousel","feature_type":"destination","description":"The Carousel is at Tiffany & Co. Foundation Grove near the aquarium and Harbor Islands ferry area. Tickets are sold onsite and weather or seasonal schedules can change daily.","latitude":42.3605464,"longitude":-71.0527607,"source_label":"Greenway Conservancy","source_url":"https://www.rosekennedygreenway.org/carousel/","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 484942338","informationSourceLabel":"Greenway Conservancy","informationSourceUrl":"https://www.rosekennedygreenway.org/carousel/","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/rose-fitzgerald-kennedy-greenway/03-rose-kennedy-greenway-p1010933-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Rose_Kennedy_Greenway_P1010933.jpg","imageAuthor":"NewtonCourt","imageLicense":"CC BY-SA 4.0","imageAlt":"Greenway Carousel at Rose Fitzgerald Kennedy Greenway"}},{"id":"17ea8e83-75e5-49a1-a180-5b3ca95de621","slug":"rings-fountain-and-wharf-district","name":"Rings Fountain and Wharf District","feature_type":"destination","description":"Rings Fountain is in the Wharf District near Milk Street. The ground-level jets are seasonal and may pause for maintenance, events, storms, or water-quality operations.","latitude":42.3584,"longitude":-71.0527,"source_label":"Rose Fitzgerald Kennedy Greenway Conservancy","source_url":"https://www.rosekennedygreenway.org/info/","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"reviewed map placement","coordinateSource":"AuditMap reviewed Greenway map placement","informationSourceLab