{"place":{"id":"launch-ma-boston-franklin-park","name":"Franklin Park","hiddenFeatureIds":[]},"features":[{"id":"9a63ba03-5e08-4946-b77e-dd8b9df49e5d","slug":"tiffany-moore-tot-lot-and-spray-play","name":"Tiffany Moore Tot Lot and spray play","feature_type":"destination","description":"Use 155 Seaver Street for the accessible playground and documented spray play. The City lists drinking water and shade but no restroom at the playground itself.","latitude":42.3088963,"longitude":-71.0916255,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/franklin-park","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 671146817","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/franklin-park","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/franklin-park/01-path-and-tree-in-franklin-park-october-2013-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Path_and_tree_in_Franklin_Park%2C_October_2013.jpg","imageAuthor":"Sarah Nichols","imageLicense":"CC BY-SA 2.0","imageAlt":"Tiffany Moore Tot Lot and spray play at Franklin Park"}},{"id":"198b7b56-0b5d-453f-8844-b8e4b45a0ba0","slug":"elma-lewis-playstead-and-white-stadium","name":"Elma Lewis Playstead and White Stadium","feature_type":"destination","description":"The Playstead is the large field landscape beside White Stadium. Construction, school athletics, festivals, and permitted events can reroute parking and paths.","latitude":42.3063,"longitude":-71.0948,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/franklin-park","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"reviewed map placement","coordinateSource":"AuditMap reviewed Franklin Park map placement","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/franklin-park","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/franklin-park/02-boston-franklin-park-golfplatz-se-9562-20190501-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Boston_Franklin_Park_Golfplatz_se_9562_20190501.jpg","imageAuthor":"Matthias Nonnenmacher","imageLicense":"CC BY-SA 4.0","imageAlt":"Elma Lewis Playstead and White Stadium at Franklin Park"}},{"id":"31d21da3-e362-4eb2-ac9d-92032440dcc3","slug":"scarboro-pond-and-wilderness-trails","name":"Scarboro Pond and Wilderness trails","feature_type":"destination","description":"Scarboro Pond and the Wilderness are in the quieter interior. Expect natural surfaces, fewer services, longer walks, and woodland conditions rather than a manicured playground visit.","latitude":42.2971256,"longitude":-71.0984518,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/franklin-park","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 91083844","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/franklin-park","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/franklin-park/03-franklin-park-official-overview.webp","imageSourceUrl":"https://www.boston.gov/parks/franklin-park","imageAuthor":"City of Boston","imageLicense":"Official city photograph","imageAlt":"Scarboro Pond and Wilderness trails at Franklin Park"}},{"id":"152bc1e6-7164-4f3c-a8f7-df881616c7cb","slug":"historic-bear-dens-and-overlook-ruins","name":"Historic Bear Dens and Overlook Ruins","feature_type":"destination","description":"The former Bear Dens and Overlook ruins are historic landscape features, not an operating animal attraction. Follow open paths and respect barriers around masonry and restoration work.","latitude":42.3018,"longitude":-71.1005,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/franklin-park","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"reviewed map placement","coordinateSource":"AuditMap reviewed Franklin Park map placement","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/franklin-park","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/franklin-park/04-path-along-scarboro-pond-october-2013-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Path_along_Scarboro_Pond%2C_October_2013.jpg","imageAuthor":"Sarah Nichols","imageLicense":"CC BY-SA 2.0","imageAlt":"Historic Bear Dens and Overlook Ruins at Franklin Park"}},{"id":"288a339b-d569-4df5-820c-ca5b5d2d6702","slug":"franklin-park-zoo","name":"Franklin Park Zoo","feature_type":"destination","description":"Franklin Park Zoo is a separately operated, ticketed attraction on the northeast side of the park. Use the zoo entrance and current Zoo New England hours, admission, parking, accessibility, and animal-care notices rather than general park rules.","latitude":42.3051612,"longitude":-71.0888892,"source_label":"Zoo New England","source_url":"https://www.zoonewengland.org/franklin-park-zoo/","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 504956903","informationSourceLabel":"Zoo New England","informationSourceUrl":"https://www.zoonewengland.org/franklin-park-zoo/","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/franklin-park/01-path-and-tree-in-franklin-park-october-2013-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Path_and_tree_in_Franklin_Park%2C_October_2013.jpg","imageAuthor":"Sarah Nichols","imageLicense":"CC BY-SA 2.0","imageAlt":"Franklin Park Zoo at Franklin Park"}},{"id":"a42690f6-19b8-407d-b76b-e9dc53cbb128","slug":"william-j-devine-golf-course","name":"William J. Devine Golf Course","feature_type":"destination","description":"The municipal golf course occupies much of Franklin Park's eastern landscape. Tee times, fees, clubhouse hours, course conditions, and player access are separate from free general park access.","latitude":42.3006446,"longitude":-71.0929277,"source_label":"City of Boston Golf","source_url":"https://www.cityofbostongolf.com/","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 1271412860","informationSourceLabel":"City of Boston Golf","informationSourceUrl":"https://www.cityofbostongolf.com/","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/franklin-park/02-boston-franklin-park-golfplatz-se-9562-20190501-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Boston_Franklin_Park_Golfplatz_se_9562_20190501.jpg","imageAuthor":"Matthias Nonnenmacher","imageLicense":"CC BY-SA 4.0","imageAlt":"William J. Devine Golf Course at Franklin Park"}},{"id":"82051c1d-2061-41b9-b9ff-5955715262d1","slug":"schoolmaster-hill","name":"Schoolmaster Hill","feature_type":"destination","description":"Schoolmaster Hill is a historic high point and ruin reached by interior park paths. Expect a walk from distributed parking, limited services, uneven ground, and fewer people than at the zoo or Playstead.","latitude":42.3030524,"longitude":-71.095691,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/franklin-park","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 544398326","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/franklin-park","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/franklin-park/03-franklin-park-official-overview.webp","imageSourceUrl":"https://www.boston.gov/parks/franklin-park","imageAuthor":"City of Boston","imageLicense":"Official city photograph","imageAlt":"Schoolmaster Hill at Franklin Park"}},{"id":"05f23a71-cc55-4124-ba86-873272af9d68","slug":"ellicott-arch-and-99-steps","name":"Ellicott Arch and 99 Steps","feature_type":"destination","description":"Ellicott Arch and the nearby 99 Steps are historic stone landscape features in Franklin Park's interior. Routes include grades and stairs, masonry may be restricted for preservation, and this is not a staffed destination.","latitude":42.2994,"longitude":-71.0997,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/franklin-park","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"reviewed map placement","coordinateSource":"AuditMap reviewed Franklin Park historic landscape placement","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/franklin-park","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/franklin-park/04-path-along-scarboro-pond-october-2013-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Path_along_Scarboro_Pond%2C_October_2013.jpg","imageAuthor":"Sarah Nichols","imageLicense":"CC BY-SA 2.0","imageAlt":"Ellicott Arch and 99 Steps at Franklin Park"}}]}
