{"place":{"id":"launch-ma-boston-boston-common","name":"Boston Common","hiddenFeatureIds":[]},"features":[{"id":"bb19d952-b6cf-4b0d-8e04-8cb77779ed63","slug":"boston-common-frog-pond","name":"Boston Common Frog Pond","feature_type":"destination","description":"Frog Pond sits on the Beacon Street side below the State House. Its spray pool, winter rink, carousel, cafe, and programs are seasonal and do not all operate together.","latitude":42.3560901,"longitude":-71.0657136,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/boston-common","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 24677760","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/boston-common","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/boston-common/01-boston-common-may-2018-004-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Boston_Common_May_2018_004.jpg","imageAuthor":"King of Hearts","imageLicense":"CC BY-SA 4.0","imageAlt":"Boston Common Frog Pond at Boston Common"}},{"id":"713ac1b2-2a4f-405c-9166-11320ecf80bc","slug":"tadpole-playground","name":"Tadpole Playground","feature_type":"destination","description":"Tadpole Playground is beside Frog Pond near Charles and Beacon Streets. It is fenced and designed for children, with the nearest dependable facilities tied to Frog Pond operations.","latitude":42.3560906,"longitude":-71.0646854,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/boston-common","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 376449332","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/boston-common","informati