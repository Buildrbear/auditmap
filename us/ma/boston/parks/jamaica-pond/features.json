{"place":{"id":"launch-ma-boston-jamaica-pond","name":"Jamaica Pond","hiddenFeatureIds":[]},"features":[{"id":"d22b758c-20b2-4aa2-8399-8052a26b19e6","slug":"jamaica-pond-boathouse","name":"Jamaica Pond Boathouse","feature_type":"destination","description":"The boathouse at 507 Jamaicaway is the service hub for seasonal rentals, programs, orientation, and nearby facilities. Private boats are not allowed.","latitude":42.3156,"longitude":-71.1178,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/jamaica-pond","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"reviewed map placement","coordinateSource":"AuditMap reviewed Jamaica Pond map placement","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/jamaica-pond","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/jamaica-pond/01-jamaica-pond-3-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Jamaica-pond-3.jpg","imageAuthor":"Bikeable","imageLicense":"CC BY-SA 2.5","imageAlt":"Jamaica Pond Boathouse at Jamaica Pond"}},{"id":"bca502e1-79cd-4d56-967b-4aab283e8a73","slug":"jamaica-pond-loop-trail","name":"Jamaica Pond loop trail","feature_type":"destination","description":"The loop follows the shore for roughly 1.5 miles. It is popular with walkers and runners, with roots, grades, road proximity, ice, and narrow passing points varying by segment.","latitude":42.3176751,"longitude":-71.1203008,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/jamaica-pond","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"representative loop point","coordinateSource":"OpenStreetMap relation 11281269","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/jamaica-pond","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/jamaica-pond/02-jamaica-pond-p1030860c-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Jamaica_Pond_P1030860c.jpg","imageAuthor":"NewtonCourt","imageLicense":"CC BY-SA 4.0","imageAlt":"Jamaica Pond loop trail at Jamaica Pond"}},{"id":"6bee7abc-f3fb-4912-97f7-299c7c3b67b2","slug":"pinebank-promontory","name":"Pinebank Promontory","feature_type":"destination","description":"Pinebank sits on the pond's north side and connects lawns, historic landscape, and Emerald Necklace routes. It is quieter than the boathouse and has fewer immediate services.","latitude":42.3198019,"longitude":-71.1197158,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/jamaica-pond","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 1115011942","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/jamaica-pond","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/jamaica-pond/03-jamaica-pond-p1030873b-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Jamaica_Pond_P1030873b.jpg","imageAuthor":"NewtonCourt","imageLicense":"CC BY-SA 4.0","imageAlt":"Pinebank Promontory at Jamaica Pond"}},{"id":"39a008ba-3022-4b19-8cac-e0dc16fd9ee7","slug":"fishing-and-shoreline-access","name":"Fishing and shoreline access","feature_type":"destination","description":"Jamaica Pond is stocked and supports legal shore fishing with the required Massachusetts license. Watch for casting lines and never treat the steep, deep pond as a swimming area.","latitude":42.3183,"longitude":-71.1231,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/jamaica-pond","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"representative access point","coordinateSource":"AuditMap reviewed Jamaica Pond access placement","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/jamaica-pond","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/jamaica-pond/04-jamaica-pond-p1030840a-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Jamaica_Pond_P1030840a.jpg","imageAuthor":"NewtonCourt","imageLicense":"CC BY-SA 4.0","imageAlt":"Fishing and shoreline access at Jamaica Pond"}},{"id":"74d41a1f-bca5-457a-92e5-3761fc89c53a","slug":"jamaica-pond-bandstand","name":"Jamaica Pond Bandstand","feature_type":"destination","description":"The bandstand is near the boathouse on the pond's southeast side and hosts seasonal concerts and programs. Outside events it is an outdoor landmark, with services tied to nearby staffed operations.","latitude":42.3158676,"longitude":-71.1174832,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/jamaica-pond","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 29789970","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/jamaica-pond","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/jamaica-pond/01-jamaica-pond-3-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Jamaica-pond-3.jpg","imageAuthor":"Bikeable","imageLicense":"CC BY-SA 2.5","imageAlt":"Jamaica Pond Bandstand at Jamaica Pond"}},{"id":"f994b1fa-4d2d-438f-89cb-5f07b8d56188","slug":"parkman-memorial","name":"Parkman Memorial","feature_type":"destination","description":"Parkman Memorial is on the pond's western side near the loop path. It is a quiet historic landmark with limited nearby services and a longer walk from the boathouse.","latitude":42.3178688,"longitude":-71.124401,"source_label"