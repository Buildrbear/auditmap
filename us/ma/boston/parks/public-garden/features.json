{"place":{"id":"launch-ma-boston-public-garden","name":"Public Garden","hiddenFeatureIds":[]},"features":[{"id":"64b95371-4fdd-45bf-ae58-82f837071140","slug":"swan-boats-and-lagoon","name":"Swan Boats and Lagoon","feature_type":"destination","description":"The Swan Boat dock is on the east side of the lagoon near Charles Street. Rides are first-come, seasonal, weather permitting, and usually last about 10 to 15 minutes.","latitude":42.3540368,"longitude":-71.0696551,"source_label":"Swan Boats of Boston","source_url":"https://swanboats.com/","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap node 4074813888","informationSourceLabel":"Swan Boats of Boston","informationSourceUrl":"https://swanboats.com/","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/public-garden/01-boston-public-garden-36008p-jpg.webp","imageSourceUrl":"https://commons.wikimedia.org/wiki/File:Boston_Public_Garden_(36008p).jpg","imageAuthor":"Rhododendrites","imageLicense":"CC BY-SA 4.0","imageAlt":"Swan Boats and Lagoon at Public Garden"}},{"id":"c59efda0-1190-4061-8c82-426380d14c6d","slug":"make-way-for-ducklings","name":"Make Way for Ducklings","feature_type":"destination","description":"The duckling statues are near the Charles and Beacon Street corner, a short walk from Boston Common. Expect photo queues at peak family times.","latitude":42.3555192,"longitude":-71.0697499,"source_label":"Boston Parks and Recreation","source_url":"https://www.boston.gov/parks/public-garden","verified_at":"2026-08-06","details":{"category":"destination","includeInParentGallery":true,"positionQuality":"mapped feature","coordinateSource":"OpenStreetMap way 236603393","informationSourceLabel":"Boston Parks and Recreation","informationSourceUrl":"https://www.boston.gov/parks/public-garden","informationCheckedAt":"2026-08-06","imageUrl":"/assets/parks/boston-super/public-garden/02-bo